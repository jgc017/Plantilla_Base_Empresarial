@model Plantilla_Base.Models.Dto.Account.DtoForgotPasswordPageViewModel

@{
    // Pantalla publica de recuperacion; no usa el layout interno del proyecto.
    Layout = "_AuthLayout";
    ViewData["Title"] = "Recuperar contrasena";
    ViewData["AuthBrand"] = "Plantilla Base";
    ViewData["AuthLogo"] = "~/img/IMAGENIA.png";
}

@* Envia el correo a POST /Account/ForgotPassword. El controlador siempre
   responde con confirmacion generica para no revelar si la cuenta existe. *@
<form asp-action="ForgotPassword" method="post" class="auth-form">
    <h2 class="auth-form-title">Recuperar contrasena</h2>
    <p class="auth-form-copy">
        Ingresa el correo registrado y enviaremos un enlace seguro para cambiar tu contrasena.
    </p>

    <div asp-validation-summary="ModelOnly" class="auth-validation mb-3"></div>

    <div class="auth-input-group">
        <i class="fa-solid fa-envelope auth-input-icon"></i>
        <input asp-for="Enlace.Email"
               class="auth-input"
               autocomplete="email"
               placeholder="Correo electronico"
               aria-label="Correo electronico" />
    </div>
    <span asp-validation-for="Enlace.Email" class="auth-field-error"></span>

    <button type="submit" class="auth-submit">
        <span>Enviar enlace</span>
        <i class="fa-solid fa-paper-plane"></i>
    </button>

    <div class="text-center mt-3">
        <a asp-action="Login" class="auth-link">Volver al login</a>
    </div>
</form>

@* Solicitud alternativa para que el administrador atienda la restauracion.
   Exige identificacion + correo para reducir suplantaciones accidentales. *@
<form asp-action="SolicitarRestauracionAdministrador" method="post" class="auth-form mt-4">
    <h2 class="auth-form-title">Ayuda del administrador</h2>
    <p class="auth-form-copy">
        Usa esta opcion si no puedes completar la recuperacion automatica. El administrador podra generar una contrasena temporal despues de validar tu solicitud.
    </p>

    <div class="auth-input-group">
        <i class="fa-solid fa-fingerprint auth-input-icon"></i>
        <input asp-for="SolicitudAdmin.Identificacion"
               class="auth-input"
               autocomplete="off"
               placeholder="Identificacion"
               aria-label="Identificacion" />
    </div>
    <span asp-validation-for="SolicitudAdmin.Identificacion" class="auth-field-error"></span>

    <div class="auth-input-group">
        <i class="fa-solid fa-envelope auth-input-icon"></i>
        <input asp-for="SolicitudAdmin.Email"
               class="auth-input"
               autocomplete="email"
               placeholder="Correo electronico registrado"
               aria-label="Correo electronico registrado" />
    </div>
    <span asp-validation-for="SolicitudAdmin.Email" class="auth-field-error"></span>

    <div class="auth-input-group auth-textarea-group">
        <i class="fa-solid fa-message auth-input-icon"></i>
        <textarea asp-for="SolicitudAdmin.Motivo"
                  class="auth-input auth-textarea"
                  maxlength="4000"
                  placeholder="Motivo de la solicitud"
                  aria-label="Motivo de la solicitud"></textarea>
    </div>
    <span asp-validation-for="SolicitudAdmin.Motivo" class="auth-field-error"></span>

    <button type="submit" class="auth-submit">
        <span>Solicitar ayuda</span>
        <i class="fa-solid fa-user-shield"></i>
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
